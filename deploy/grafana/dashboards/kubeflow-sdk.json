  "templating": {
    "list": [
      {
        "name": "trainjob",
        "label": "Training job",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(kubeflow_training_metric, kubeflow_trainjob_name)",
          "refId": "trainjob"
        },
        "definition": "label_values(kubeflow_training_metric, kubeflow_trainjob_name)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "sort": 1
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
