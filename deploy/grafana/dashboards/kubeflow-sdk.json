    {
      "type": "stat",
      "title": "Jobs submitted",
      "description": "TrainJobs submitted with TrainerClient.train() in the time range.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum((last_over_time(kubeflow_trainjob_submitted_total[$__range]) - (last_over_time(kubeflow_trainjob_submitted_total[$__range] offset $__range) or last_over_time(kubeflow_trainjob_submitted_total[$__range]) * 0)))",
          "legendFormat": "__auto",
          "instant": true,
          "range": false,
          "exemplar": false
